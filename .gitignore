gitignore
# Ambientes virtuais
venv/
env/
.venv/
*.conda/
conda-meta/

# Cache do Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# Pesos e checkpoints de modelos
*.pt
*.pth
*.h5
*.ckpt
*.onnx
*.safetensors
checkpoints/
**/checkpoints/
weights/
**/weights/

# Datasets grandes / dados brutos
data/
dataset/
*.npz
*.npy

# Logs e resultados de treino (TensorBoard, wandb, etc.)
logs/
runs/
wandb/
*.log

# Configurações do sistema/editor
.DS_Store
.vscode/
.idea/
Thumbs.db

# Variáveis de ambiente / segredos
.env
*.key
